# Copy to deploy/.env on the ECS instance. Never commit the copy.
BIOCANARY_ENVIRONMENT=production
# openssl rand -hex 32
BIOCANARY_SECRET_KEY=
BIOCANARY_COOKIE_SECURE=true
BIOCANARY_DEMO_ENABLED=false
BIOCANARY_MODEL_PATH=/srv/ml/artifacts/inhibition_classifier.json

# ECS
BIOCANARY_COMPUTE_PROVIDER=huawei_ecs

# RDS for PostgreSQL
BIOCANARY_DATABASE_PROVIDER=huawei_rds
BIOCANARY_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@RDS_PRIVATE_IP:5432/biocanary?sslmode=require

# Distributed Cache Service (Redis)
BIOCANARY_CACHE_PROVIDER=huawei_dcs
BIOCANARY_REDIS_URL=redis://:PASSWORD@DCS_PRIVATE_IP:6379/0

# OBS
BIOCANARY_OBJECT_PROVIDER=huawei_obs
BIOCANARY_OBS_ENDPOINT=https://obs.REGION.myhuaweicloud.com
BIOCANARY_OBS_BUCKET=
BIOCANARY_OBS_ACCESS_KEY=
BIOCANARY_OBS_SECRET_KEY=

# ModelArts real-time service. Use "local" until the service is deployed.
BIOCANARY_INFERENCE_PROVIDER=modelarts
BIOCANARY_MODELARTS_ENDPOINT=https://.../v1/infers/SERVICE_ID
# appcode | iam
BIOCANARY_MODELARTS_AUTH=appcode
BIOCANARY_MODELARTS_APP_CODE=
# For BIOCANARY_MODELARTS_AUTH=iam
BIOCANARY_IAM_ENDPOINT=https://iam.REGION.myhuaweicloud.com
BIOCANARY_IAM_DOMAIN=
BIOCANARY_IAM_USERNAME=
BIOCANARY_IAM_PASSWORD=
BIOCANARY_IAM_PROJECT=REGION
